# ShelfSense ortam değişkenleri. Kopyala: cp .env.example .env
# .env COMMIT EDİLMEZ (bkz. .gitignore).

# PostgreSQL bağlantısı (db/connection.py)
DATABASE_URL=postgresql://shelfsense:shelfsense@localhost:5432/shelfsense

# --- LLM sağlayıcı (assistant/llm_client.py) ---
# HEDEF: PanGu (Huawei Cloud) — voucher geldiğinde.
# ŞİMDİ: voucher yok. Geliştirme geçici bir sağlayıcıyla yapılır.
#        llm_client.py sağlayıcıdan BAĞIMSIZ yazılır: geçişte yalnızca
#        aşağıdaki değerler değişir, kod değişmez.
LLM_BASE_URL=
LLM_API_KEY=

# PanGu'ya geçildiğinde doldurulacak. V1 uç noktası bu ikisini ister:
#   POST {LLM_BASE_URL}/v1/{PANGU_PROJECT_ID}/deployments/{PANGU_DEPLOYMENT_ID}/chat/completions
PANGU_PROJECT_ID=
PANGU_DEPLOYMENT_ID=

# YOLO/ONNX model yolu (perception çıktısı; backend algı çağrısı)
MODEL_PATH=./models/shelf.onnx
