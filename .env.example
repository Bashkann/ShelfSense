# PostgreSQL
POSTGRES_DB=shelfsense
POSTGRES_USER=shelfsense
POSTGRES_PASSWORD=shelfsense_local_password
POSTGRES_PORT=5432

# SQLAlchemy PostgreSQL connection
DATABASE_URL=postgresql+psycopg://shelfsense:shelfsense_local_password@localhost:5432/shelfsense

# LLM provider
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# Perception model
MODEL_PATH=./models/shelf.onnx