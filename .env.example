# ShelfSense ortam değişkenleri. Kopyala: cp .env.example .env
# .env COMMIT EDİLMEZ (bkz. .gitignore).

# PostgreSQL bağlantısı (db/connection.py)
DATABASE_URL=postgresql://shelfsense:shelfsense@localhost:5432/shelfsense

# LLM sağlayıcı (assistant/llm_client.py)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# YOLO/ONNX model yolu (perception çıktısı; backend algı çağrısı)
MODEL_PATH=./models/shelf.onnx
